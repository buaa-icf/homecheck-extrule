{
    "name": "extrulesproject",
    "version": "1.0.0",
    "description": "ArkTS code check custom rules based on homecheck framework",
    "main": "lib/index.js",
    "scripts": {
        "postinstall": "patch-package",
        "prepack": "tsc -p ./tsconfig.prod.json",
        "build": "tsc -p ./tsconfig.prod.json",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "scan:batch": "node ./scripts/batchScanRepos.js",
        "scan:split": "node ./scripts/recursiveSplitScan.js",
        "perf:gitcode": "node ./scripts/gitcodeArktsPerfTest.js"
